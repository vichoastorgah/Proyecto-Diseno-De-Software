# ---- Server configuration (copy to .env and fill in) ----

# Google OAuth client id (same value as VITE_GOOGLE_CLIENT_ID in client/.env).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 32+ random characters used to sign session tokens. Generate one with:
#   deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=change-me-to-a-long-random-value

# Administrators (comma-separated). If both are empty, ALLOWED_* are the admins.
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL_DOMAINS=

# Other accounts allowed to sign in (survey participants can always sign in).
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Lets a signed-in admin act as another person in surveys (live demos only).
ALLOW_DEMO_SURVEY_IDENTITY=false

# Public URLs used in emails.
APP_BASE_URL=http://localhost:5173
VOTE_BASE_URL=http://localhost:5173/vote
VOTE_TOKEN_TTL_HOURS=48
DEFAULT_EMAIL_LANGUAGE=es

# CORS origin(s) of the web app (comma-separated) and API port.
ALLOWED_ORIGIN=http://localhost:5173
PORT=8000

# SQLite database file (default: server/storage/app.db, git-ignored).
# DATABASE_PATH=server/storage/app.db

# Real email delivery (optional). Without SMTP_USER/SMTP_PASS emails are printed in the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
