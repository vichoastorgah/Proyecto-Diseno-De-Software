{
  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.13",
    "@oak/oak": "jsr:@oak/oak@^17",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/path": "jsr:@std/path@^1",
    "@types/nodemailer": "npm:@types/nodemailer@6.4.17",
    "jose": "npm:jose@5.9.6",
    "nodemailer": "npm:nodemailer@6.9.16",
    "postgres": "npm:postgres@3.4.9"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-sys server/server.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys server/server.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-sys server/tests/",
    "check": "deno check server/server.ts server/tests/",
    "lint": "deno lint server/"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 120
  },
  "deploy": {
    "install": "deno install --entrypoint server/server.ts",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./server/server.ts"
    }
  }
}
